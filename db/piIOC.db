#	field(SCAN, "Passive")
#	field(DTYP, "stream")
#        field(INP, "@piIOC.proto getLim($(card),$(axis)) $(ASYNPORT)")
#	field(PINI, "NO")
#}
# Limits
record(bi, "$(MOT)_$(card)_$(axis):limit_right") {
	field(DESC, "Right (+) travel limit")
	field(ZNAM, "Not tripped")
	field(ONAM, "TRIPPED!!")
	field(ZSV, "NO_ALARM")      # Severità quando il bit è 0 (non trippato)
	field(OSV, "MAJOR")         # Severità quando il bit è 1 (trippato)
}
record(bi, "$(MOT)_$(card)_$(axis):limit_left") {
	field(DESC, "Left (-) travel limit")
	field(ZNAM, "Not tripped")
	field(ONAM, "TRIPPED!!")
	field(ZSV, "NO_ALARM")      # Severità quando il bit è 0 (non trippato)
	field(OSV, "MAJOR")         # Severità quando il bit è 1 (trippato)
}
# Moving
record(bi,  "$(MOT)_$(card)_$(axis):moving") {
	field(DESC, "Motor is moving?")
	field(ZNAM, "Ready")
	field(ONAM, "Moving")
}
# Position
record(bo, "$(MOT)_$(card)_$(axis):reqpos") {
	field(DESC, "Request Position")
}
record(ai, "$(MOT)_$(card)_$(axis):act_pos") {
	field(DESC, "Machine Position")
	field(SCAN, "Passive")
	field(DTYP, "stream")
	field(INP, "@piIOC.proto getPos($(card),$(axis)) $(ASYNPORT)")
	field(PINI, "NO")
}
record(ai, "$(MOT)_$(card)_$(axis):pos") {
	field(DESC, "Actual Position")
	field(SCAN, "Passive")
	field(PINI, "NO")
}
#
#       Homing
#
record(bo, "$(MOT)_$(card)_$(axis):reqhome") {
        field(DESC, "Request Homing $(card)_$(axis)")
        field(ZNAM, "0")  # Label for state 0
        field(ONAM, "1")  # Label for state 1
	field(PINI, "NO")
}
record(ai, "$(MOT)_$(card)_$(axis):home") {
        field(DESC, "Homing $(card)_$(axis)")
        field(SCAN, "Passive")
        field(DTYP, "stream")
        field(INP, "@piIOC.proto setHoming($(card),$(axis),$(homing)) $(ASYNPORT)")
        field(PINI, "NO")
}
#
#	MOVE ABSOLUTE
#
record(ao, "$(MOT)_$(card)_$(axis):setma") {
	field(DESC, "Set Move Absolute $(card)_$(axis)")
	field(PINI, "NO")
}
record(ao, "$(MOT)_$(card)_$(axis):ma") {
	field(DESC, "Move Absolute $(card)_$(axis)")
	field(SCAN, "Passive")
        field(DTYP, "stream")
        field(OUT, "@piIOC.proto setMovAbs($(card),$(axis)) $(ASYNPORT)")
        field(PINI, "NO")
}
#
#       MOVE RELATIVE
#
record(ao, "$(MOT)_$(card)_$(axis):setmr") {
        field(DESC, "Set Move Relative $(card)_$(axis)")
        field(PINI, "NO")
}
record(ao, "$(MOT)_$(card)_$(axis):mr") {
        field(DESC, "Move Relative $(card)_$(axis)")
        field(SCAN, "Passive")
        field(DTYP, "stream")
        field(OUT, "@piIOC.proto setMovRel($(card),$(axis)) $(ASYNPORT)")
        field(PINI, "NO")
}
#
#	Veocity
#
record(ao, "$(MOT)_$(card)_$(axis):setve") {
	field(DESC, "Set Velocity $(card)_$(axis)")
	field(PINI, "NO")
}
record(ao, "$(MOT)_$(card)_$(axis):vel") {
	field(DESC, "Velocity $(card)_$(axis)")
	field(SCAN, "Passive")
	field(DTYP, "stream")
	field(OUT, "@piIOC.proto setVel($(card),$(axis)) $(ASYNPORT)")
	field(PINI, "NO")
}
record(bo, "$(MOT)_$(card)_$(axis):reqvel") {
	field(DESC, "Request Velocity")
}
record(ai, "$(MOT)_$(card)_$(axis):act_vel") {
	field(DESC, "Machine Velocity")
	field(SCAN, "Passive")
	field(DTYP, "stream")
	field(INP, "@piIOC.proto getVel($(card),$(axis)) $(ASYNPORT)")
	field(PINI, "NO")
}
record(ai, "$(MOT)_$(card)_$(axis):real_vel") {
	field(DESC, "Actual Velocity")
	field(SCAN, "Passive")
	field(PINI, "NO")
}
