record(stringin, "$(MOT):model") {
	field(DESC, "Device Version")
	field(SCAN, "Passive")
	field(DTYP, "stream")
	field(INP, "@piIOC.proto getModel() $(ASYNPORT)")
	field(PINI, "YES")
}
record(stringin, "$(MOT)_$(card)_$(axis):err") {
        field(DESC, "Get Error $(card)")
        field(SCAN, "Passive")
        field(DTYP, "stream")
        field(INP, "@piIOC.proto getError($(card)) $(ASYNPORT)")
        field(PINI, "YES")
}
record(stringin, "$(MOT)_$(card)_$(axis):busy") {
        field(DESC, "Busy $(card)_$(axis) - (0=busy, 1=ready)")
        field(SCAN, "Passive")
        field(VAL, "1")
        field(PINI, "YES")
}
record(ao, "$(MOT)_$(card)_$(axis):mres") {
        field(DESC, "Conversion in $(EGU)")
        field(VAL, "$(MRES)")
        field(PINI, "YES")
}
record(stringout, "$(MOT)_$(card)_$(axis):egu") {
	field(DESC, "Unity")
	field(VAL, "$(EGU)")
	field(PINI, "YES")
}
record(ao, "$(MOT)_$(card)_$(axis):polarity") {
	field(DESC, "Motor Direction")
	field(VAL, "$(direct)")
	field(PINI, "YES")
}
record(bo, "$(MOT)_$(card)_$(axis):stop") {
	field(DESC, "Emergency Stop")
	field(SCAN, "Passive")
	field(DTYP, "stream")
	field(OUT, "@piIOC.proto setStop($(card),$(axis)) $(ASYNPORT)")
	field(PINI, "NO")
}
#
#       ON/OFF Motor
#
record(bo, "$(MOT)_$(card)_$(axis):reqmotor") {
	field(DESC, "Request On/Off Motor $(card)_$(axis)")
	field(ZNAM, "0")  # Label for state 0
	field(ONAM, "1")  # Label for state 1
}
record(bo, "$(MOT)_$(card)_$(axis):motor") {
	field(DESC, "On/Off Motor $(card)_$(axis)")
	field(SCAN, "Passive")
	field(DTYP, "stream")
	field(OUT, "@piIOC.proto setStatus($(card),$(axis)) $(ASYNPORT)")
	field(PINI, "NO")
}
record(ai, "$(MOT)_$(card)_$(axis):motor_status") {
	field(DESC, "Motor On?")
	field(PINI, "NO")
}
#
#	Status
#
record(ai, "$(MOT)_$(card)_$(axis):status_mode") {
	field(DESC, "SNL status IOC")
	field(VAL, "0")
	field(PINI, "YES")
}
record(bo, "$(MOT)_$(card)_$(axis):ask_request") {
	field(DESC, "Request Infos from IOC")
	field(SCAN, "Passive")
	field(VAL, "1")
	field(PINI, "YES")
	field(OUT, "$(MOT)_$(card)_$(axis):status_mode.VAL PP")
}
#
#record(ai, "$(MOT)_$(card)_$(axis):ms_status") {
record(stringin, "$(MOT)_$(card)_$(axis):ms_status") {
	field(DESC, "Status Motor")
	field(SCAN, "Passive")
	field(DTYP, "stream")
#	field(INP, "@piIOC.proto getStatus($(card),$(axis)) $(ASYNPORT)")
        field(INP, "@piIOC.proto getMoving($(card),$(axis)) $(ASYNPORT)")
	field(PINI, "NO") 
}
record(ai, "$(MOT)_$(card)_$(axis):ms_status_opt") {
#record(stringin, "$(MOT)_$(card)_$(axis):ms_status_opt") {
	field(DESC, "Status Motor Supplementary")
	field(SCAN, "Passive")
	field(DTYP, "stream")
	field(INP, "@piIOC.proto getStatus($(card),$(axis)) $(ASYNPORT)")
#        field(INP, "@piIOC.proto getMoving($(card),$(axis)) $(ASYNPORT)")
	field(PINI, "NO")
}
